require "shellwords"
# Come Through — Fastlane
# Used by .github/workflows/ios-testflight.yml (macOS runner).
# Secrets via ENV — never commit keys.

default_platform(:ios)

platform :ios do
  desc "Archive Come Through and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_id = ENV.fetch("APPLE_API_KEY_ID")
    issuer_id = ENV.fetch("APPLE_API_ISSUER_ID")
    key_content = ENV.fetch("APPLE_API_KEY_P8")
    is_b64 = !key_content.include?("BEGIN PRIVATE KEY")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_b64,
      duration: 1200,
      in_house: false
    )

    project = "ios/App/App.xcodeproj"
    scheme = "App"
    bundle_id = "app.comethrough.family"

    # Unique build number per Actions run (or timestamp fallback)
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: project,
      build_number: build_number.to_s
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: project,
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      targets: ["App"]
    )

    # Prefer explicit AuthKey path for -allowProvisioningUpdates
    auth_key_path = ENV["AUTH_KEY_PATH"]
    xcargs = "DEVELOPMENT_TEAM=#{team_id} -allowProvisioningUpdates"
    if auth_key_path && File.exist?(auth_key_path)
      xcargs += " -authenticationKeyPath #{Shellwords.escape(auth_key_path)}"
      xcargs += " -authenticationKeyID #{key_id}"
      xcargs += " -authenticationKeyIssuerID #{issuer_id}"
    end

    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      silent: false,
      export_method: "app-store",
      output_directory: "build",
      output_name: "ComeThrough.ipa",
      build_path: "build",
      derived_data_path: "build/DerivedData",
      xcargs: xcargs,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id,
        uploadSymbols: true,
        compileBitcode: false,
        thinning: "<none>"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV["CHANGELOG"] || "Come Through TestFlight build"
    )

    UI.success("Uploaded build #{build_number} to TestFlight for #{bundle_id}")
  end

  desc "Validate signing/env without uploading"
  lane :doctor do
    UI.message("APPLE_TEAM_ID=#{ENV['APPLE_TEAM_ID']}")
    UI.message("APPLE_API_KEY_ID=#{ENV['APPLE_API_KEY_ID']}")
    UI.message("APPLE_API_ISSUER_ID=#{ENV['APPLE_API_ISSUER_ID']}")
    UI.message("P8 present=#{!(ENV['APPLE_API_KEY_P8'].to_s.empty?)}")
    UI.message("Project exists=#{File.exist?('ios/App/App.xcodeproj/project.pbxproj')}")
    UI.message("Scheme exists=#{File.exist?('ios/App/App.xcodeproj/xcshareddata/xcschemes/App.xcscheme')}")
  end
end
