# Come Through — Fastlane (GitHub Actions macOS runner)
require "shellwords"
require "spaceship"

default_platform(:ios)

def clean_env(key)
  ENV.fetch(key).to_s.gsub("\r", "").strip
end

def ensure_bundle_and_app!(bundle_id:, team_id:, key_id:, issuer_id:, auth_key_path:)
  token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: issuer_id,
    filepath: auth_key_path
  )
  Spaceship::ConnectAPI.token = token

  # --- Bundle ID (Identifiers) ---
  bid = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: bundle_id }).first
  if bid.nil?
    UI.message("Creating Bundle ID #{bundle_id}…")
    bid = Spaceship::ConnectAPI::BundleId.create(
      name: "Come Through",
      identifier: bundle_id,
      platform: "IOS"
    )
    UI.success("Created Bundle ID #{bid.identifier}")
  else
    UI.message("Bundle ID already exists: #{bid.identifier}")
  end

  # --- App Store Connect app record ---
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  if app.nil?
    UI.message("Creating App Store Connect app Come Through…")
    begin
      app = Spaceship::ConnectAPI::App.create(
        name: "Come Through",
        language: "en-US",
        locale: "en-US",
        bundle_id: bundle_id,
        sku: "come-through",
        platforms: ["IOS"]
      )
      UI.success("Created ASC app")
    rescue => e
      # Name taken / already exists races
      UI.important("App create: #{e.message}")
      app = Spaceship::ConnectAPI::App.find(bundle_id)
    end
  else
    UI.message("ASC app already exists: #{app.name}")
  end

  app
end

platform :ios do
  desc "Archive Come Through and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    team_id = clean_env("APPLE_TEAM_ID")
    key_id = clean_env("APPLE_API_KEY_ID")
    issuer_id = clean_env("APPLE_API_ISSUER_ID")
    key_content = ENV.fetch("APPLE_API_KEY_P8").to_s.gsub("\r", "")
    is_b64 = !key_content.include?("BEGIN PRIVATE KEY")

    UI.user_error!("APPLE_TEAM_ID empty") if team_id.empty?
    UI.user_error!("APPLE_API_KEY_ID empty") if key_id.empty?
    UI.user_error!("APPLE_API_ISSUER_ID empty") if issuer_id.empty?
    UI.user_error!("APPLE_API_KEY_P8 empty") if key_content.strip.empty?

    UI.message("Team ID length=#{team_id.length} Key ID length=#{key_id.length}")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_b64,
      duration: 1200,
      in_house: false
    )

    project = "ios/App/App.xcodeproj"
    scheme = "App"
    bundle_id = "app.comethrough.family"

    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: project,
      build_number: build_number.to_s
    )

    auth_key_path = ENV["AUTH_KEY_PATH"].to_s.strip
    UI.user_error!("AUTH_KEY_PATH missing") if auth_key_path.empty? || !File.exist?(auth_key_path)

    ensure_bundle_and_app!(
      bundle_id: bundle_id,
      team_id: team_id,
      key_id: key_id,
      issuer_id: issuer_id,
      auth_key_path: auth_key_path
    )

    # Create/install Apple Distribution certificate into the CI temp keychain
    cert(
      api_key: api_key,
      development: false,
      force: false,
      generate_apple_certs: true
    )

    # App Store distribution profile (no devices required)
    profile_uuid = sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      team_id: team_id,
      provisioning_name: "Come Through AppStore CI",
      ignore_profiles_with_different_name: true,
      force: true,
      skip_certificate_verification: true
    )
    profile_name = ENV["SIGH_NAME"] || "Come Through AppStore CI"
    UI.message("Using profile #{profile_name} uuid=#{profile_uuid}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "iPhone Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      targets: ["App"]
    )

    xcargs = [
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_STYLE=Manual",
      'CODE_SIGN_IDENTITY="iPhone Distribution"',
      "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", Shellwords.escape(auth_key_path),
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    ].join(" ")

    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      silent: false,
      export_method: "app-store",
      output_directory: "build",
      output_name: "ComeThrough.ipa",
      build_path: "build",
      derived_data_path: "build/DerivedData",
      xcargs: xcargs,
      export_team_id: team_id,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => profile_name
        },
        uploadSymbols: true,
        compileBitcode: false,
        thinning: "<none>"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV["CHANGELOG"] || "Come Through TestFlight build"
    )

    UI.success("Uploaded build #{build_number} to TestFlight for #{bundle_id}")
  end
end
